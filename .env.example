# --- Local Offline LLM Configuration (Primary Decoupled Execution Engine) ---
# Run 100% offline standalone via Ollama (llama3.2)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=llama3.2

# --- Cloud Arbitration Engine (Automated Fallback for Contenders with Delta <= 8.0%) ---
# Optional: Used exclusively for tie-breaking microstructural synthesis
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Web UI & Workbench Settings ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
