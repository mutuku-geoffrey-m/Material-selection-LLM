# --- Cloud LLM API Keys (Optional) ---
# If provided, the system can utilize cloud LLMs for synthesis.
# If omitted or offline, the system automatically falls back to:
# 1) Local Ollama LLM, or 2) Built-in Autonomous Offline Expert Engine.
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Local Offline LLM Configuration (Section 3 Capstone Architecture) ---
# Run 100% offline standalone on your defense laptop via Ollama / llama.cpp
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=llama3.2

# --- Web UI & Application Settings ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
