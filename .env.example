# EMS-OS: Engineering Materials Selection System
# Project code EKM/1/2026. Department of Mechanical and Manufacturing Engineering, University of Nairobi.
# Copy this file to .env and adjust the values if required.

# Local language model (served by Ollama; no internet connection is needed once the model is installed)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=llama3.2:1b

# Optional cloud arbitration for near-ties (top candidates within 8 % on the governing index)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Web interface
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=127.0.0.1

# Timeouts in seconds. A call fails only when no output arrives for this long.
EMS_UNDERSTANDING_TIMEOUT_S=120
EMS_LLM_TIMEOUT_S=120
EMS_ROUTER_TIMEOUT_S=20
EMS_CLOUD_TIMEOUT_S=20
